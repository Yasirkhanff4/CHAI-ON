service firebase.storage {
  match /b/{bucket}/o {
    // Staff claims are the source of truth for storage writes.
    function isStaff() {
      return request.auth != null
        && (request.auth.token.get('role', 'CUSTOMER') == 'ADMIN'
          || request.auth.token.get('role', 'CUSTOMER') == 'SUPER_ADMIN');
    }

    // Product photography: public read, staff-only write, images only.
    match /products/{allPaths=**} {
      allow read: if true;

      // Uploads and replacements must stay images under 5 MB.
      allow create, update: if isStaff()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Deletes have no request.resource, so only the role is checked.
      allow delete: if isStaff();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
