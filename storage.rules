service firebase.storage {
  match /b/{bucket}/o {
    // Product photography: public read, staff-only write, images only.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.token.get('role', 'CUSTOMER') == 'ADMIN'
          || request.auth.token.get('role', 'CUSTOMER') == 'SUPER_ADMIN')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
