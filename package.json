{
  "name": "chai-on",
  "private": true,
  "version": "0.1.0",
  "description": "CHAI ON — tea ordering and management for Your Office. Your Chai.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-chaion \"node tests/firestore.rules.test.mjs\"",
    "functions:build": "npm --prefix functions run build",
    "test:orders": "firebase emulators:exec --only firestore,auth,functions --project demo-chaion \"node tests/order.functions.test.mjs\""
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
