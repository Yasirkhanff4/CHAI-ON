# Firebase web configuration for the CHAYON customer site and admin panel.
# Copy to .env and fill in from Firebase Console → Project settings → Your apps.
# These are public identifiers, NOT secrets. Never put a service account key,
# admin SDK credential or private API key in a VITE_ variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Use the local Firebase Emulator Suite instead of production (development only).
VITE_FIREBASE_USE_EMULATORS=false
